# ============================================================
#  Municipal Portal - local development environment
#  Copy this file to ".env" and fill in the values.
# ============================================================

# ---- Backend (Supabase / PostgreSQL) ----
VITE_SUPABASE_URL=http://localhost:8000
SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_PUBLISHABLE_KEY=paste-anon-key-here
SUPABASE_PUBLISHABLE_KEY=paste-anon-key-here

# ---- Google Maps (browser map widget) ----
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# ---- Weather & Air Quality (server-side only) --------------
# Required OUTSIDE the Lovable environment (local dev + AWS).
# One Google Cloud API key with these three APIs enabled:
#   * Geocoding API
#   * Weather API
#   * Air Quality API
# Full step-by-step guide: deploy/WEATHER-AND-AIR.md
# Leave EMPTY inside Lovable Preview - the built-in connector is used instead.
# Never prefix this with VITE_ ; it must stay server-side.
GOOGLE_API_KEY=

# ---- App server ----
PORT=3000
