# ============================================================
#  Municipal Portal - environment settings
#  Copy this file to ".env" (same folder as package.json)
#  and fill in the values. Lines starting with # are notes.
# ============================================================

# ---- 1. Where the backend lives -----------------------------
# On your laptop this is http://localhost:8000
# On AWS this is https://api.<your-main-domain>  (or http://<elastic-ip>:8000 before HTTPS)
VITE_SUPABASE_URL=http://localhost:8000
SUPABASE_URL=http://localhost:8000

# ---- 2. Public key (safe to be seen in the browser) ---------
# Printed by deploy/generate-keys.sh
VITE_SUPABASE_PUBLISHABLE_KEY=paste-anon-key-here
SUPABASE_PUBLISHABLE_KEY=paste-anon-key-here

# ---- 3. SECRET keys - never share, never commit -------------
# Also printed by deploy/generate-keys.sh
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
JWT_SECRET=paste-40-character-random-text-here

# ---- 4. Database (PostgreSQL) -------------------------------
POSTGRES_PASSWORD=choose-a-strong-database-password
# Only change these if you use AWS RDS instead of the bundled database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ---- 5. File storage on AWS S3 ------------------------------
# Leave STORAGE_BACKEND=file to store uploads on the server disk (fine for testing).
# Set STORAGE_BACKEND=s3 and fill the rest to use AWS S3 (recommended in production).
STORAGE_BACKEND=file
AWS_REGION=ap-south-1
AWS_S3_BUCKET=my-municipal-portal-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- 6. Google Maps (optional) ------------------------------
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=

# ---- 7. App server ------------------------------------------
PORT=3000
